def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)

def build_gt_from_edges(edge_set, node_names):
    n_nodes = len(node_names)
    gt_matrix = np.zeros((n_nodes, n_nodes), dtype=int)
    name_to_idx = {name.lower().strip(): idx for idx, name in enumerate(node_names)}
    for u, v in edge_set:
        u_idx = name_to_idx.get(u.lower().strip())
        v_idx = name_to_idx.get(v.lower().strip())
        if u_idx is not None and v_idx is not None:
            gt_matrix[u_idx, v_idx] = 1
    return gt_matrix

def load_ground_truth_from_csv(dataset_name, data_dir, node_names):
    n_nodes = len(node_names)
    ds_lower = dataset_name.lower()
    
    if "alarm" in ds_lower:
        return build_gt_from_edges(ALARM_GT_EDGES, node_names)
    if "sachs" in ds_lower:
        return build_gt_from_edges(SACHS2_GT_EDGES, node_names)
    if ds_lower in HARDCODED_GT and HARDCODED_GT[ds_lower].shape[0] == n_nodes:
        return HARDCODED_GT[ds_lower]

    possible_names = [
        f"{ds_lower}_Ground_Truth.csv", f"{ds_lower}_ground_truth.csv",
        f"{dataset_name}_Ground_Truth.csv", f"{ds_lower}_gt.csv",
        f"{dataset_name}_gt.csv", "gt.csv"
    ]
    
    gt_file_path = None
    for fname in possible_names:
        full_p = os.path.join(data_dir, fname)
        if os.path.exists(full_p):
            gt_file_path = full_p
            break

    if gt_file_path is None:
        return None

    try:
        gt_df = pd.read_csv(gt_file_path)
        if gt_df.shape[0] == n_nodes and (gt_df.shape[1] == n_nodes or gt_df.shape[1] == n_nodes + 1):
            if gt_df.shape[1] == n_nodes + 1:
                gt_df = gt_df.iloc[:, 1:]
            return gt_df.values.astype(int)

        gt_matrix = np.zeros((n_nodes, n_nodes), dtype=int)
        name_to_idx = {name.lower(): idx for idx, name in enumerate(node_names)}
        
        for _, row in gt_df.iterrows():
            u_str, v_str = str(row.iloc[0]).lower(), str(row.iloc[1]).lower()
            idx_u = name_to_idx.get(u_str, None)
            idx_v = name_to_idx.get(v_str, None)
            if idx_u is not None and idx_v is not None:
                gt_matrix[idx_u, idx_v] = 1
                
        return gt_matrix
    except Exception as e:
        print(f"Error loading GT file {gt_file_path}: {e}")
        return None

